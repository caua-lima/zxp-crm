# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis em
# Vercel > Settings > Environment Variables (produção).
#
# ⚠️ Nenhuma delas tem NEXT_PUBLIC_ no nome, e isso é proposital: variável com
# NEXT_PUBLIC_ vai embutida no JavaScript que o navegador baixa. Aqui dentro há
# a chave de acesso total ao banco e a senha do painel — as duas só podem
# existir no servidor.

# ── Supabase ────────────────────────────────────────────────────────────
# O MESMO projeto usado pela landing page (rumo-lp). Project Settings > API.
# Use a chave secreta (service_role / sb_secret_...), nunca a publishable.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Acesso ao painel ────────────────────────────────────────────────────
# Senha única de entrada. É o que separa um estranho do telefone e do relato
# pessoal de adolescentes — trate como senha de banco, não como senha de teste.
ADMIN_PASSWORD=

# Segredo que assina o cookie de sessão. Mínimo 32 caracteres.
# Gere um com:  openssl rand -base64 32
AUTH_SECRET=
